# Zynthera development settings.
# Copy this file to .env. Every value here is safe for local development only.
# Anything containing "dev-only" is a placeholder: the API and the agent refuse
# to start with it when ZYN_ENV=production.

# ---------------------------------------------------------------- Compose services
# Postgres user, password and database created by `make up`.
POSTGRES_USER=zynthera
POSTGRES_PASSWORD=zynthera_dev
POSTGRES_DB=zynthera
# Host ports. If another Postgres or Redis already uses these, change them here
# AND in ZYN_DATABASE_URL / ZYN_REDIS_URL below.
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------- API
# development or production.
ZYN_ENV=development
# Address the API listens on.
ZYN_API_ADDR=127.0.0.1:8080
# Postgres connection string.
ZYN_DATABASE_URL=postgres://zynthera:zynthera_dev@127.0.0.1:5432/zynthera?sslmode=disable
# Redis connection string (job queue, rate limits, live updates).
ZYN_REDIS_URL=redis://127.0.0.1:6379/0
# Public address of the web app. Used for links in emails and for Origin checks.
ZYN_WEB_ORIGIN=http://localhost:3000
# 32 random bytes, base64. Encrypts host credentials stored in the database.
# Generate a real one with: openssl rand -base64 32
ZYN_SECRETS_KEY=enludGhlcmEtZGV2LW9ubHktc2VjcmV0cy1rZXktMDA=
# How long a login lasts.
ZYN_SESSION_TTL_HOURS=720
# Outgoing email. Mailpit in development (web UI at http://localhost:8025).
ZYN_SMTP_HOST=127.0.0.1
ZYN_SMTP_PORT=1025
ZYN_SMTP_USER=
ZYN_SMTP_PASS=
ZYN_MAIL_FROM=Zynthera <no-reply@zynthera.local>
# Admin account created by `make seed`.
ZYN_SEED_ADMIN_EMAIL=admin@zynthera.local
ZYN_SEED_ADMIN_PASSWORD=dev-only-admin-password
# Sizes offered in the creation wizard.
ZYN_ALLOWED_RAM_MB=2048,4096,8192,16384
ZYN_ALLOWED_VCPUS=1,2,4,8
ZYN_ALLOWED_DISK_GB=40,80,160
# Per-user limits. Can be overridden per user in the database.
ZYN_DEFAULT_MAX_VMS=1
ZYN_DEFAULT_MAX_RAM_MB=16384
ZYN_DEFAULT_MAX_VCPUS=8
ZYN_DEFAULT_MAX_DISK_GB=160
# Suspend a PC after this many minutes with no viewer connected.
ZYN_IDLE_SUSPEND_MINUTES=15
# The viewer asks "still there?" after this many minutes without input.
ZYN_IDLE_INPUT_MINUTES=60
# Longest keep-alive a user may set.
ZYN_MAX_KEEP_ALIVE_HOURS=12
# Snapshots allowed per PC.
ZYN_MAX_SNAPSHOTS_PER_VM=5
# Largest single file upload.
ZYN_MAX_UPLOAD_MB=2048
# Lifetime of desktop stream tokens and file transfer tokens.
ZYN_STREAM_TOKEN_TTL_SECONDS=60
ZYN_FILES_TOKEN_TTL_SECONDS=600
# A host with no heartbeat for this long counts as offline.
ZYN_HOST_OFFLINE_AFTER_SECONDS=45
# Share of host disk the scheduler never hands out.
ZYN_DISK_HEADROOM_PERCENT=10

# ---------------------------------------------------------------- Agent
# In development the agent reads this same file.
# On a real host these live in /etc/zynthera/agent.env.
# Address the agent listens on. Stays on loopback in production; Caddy fronts it.
ZYN_AGENT_ADDR=127.0.0.1:9090
# This host's id in the hosts table. `make seed` creates the matching row.
ZYN_AGENT_HOST_ID=00000000-0000-4000-8000-000000000001
# Shared secret for API <-> agent calls.
ZYN_AGENT_TOKEN=dev-only-agent-token
# Key that signs and verifies browser stream and file tokens.
ZYN_AGENT_STREAM_SECRET=dev-only-stream-secret
# Where the agent sends heartbeats.
ZYN_AGENT_API_URL=http://127.0.0.1:8080
# The only Origin allowed on the agent's browser-facing endpoints.
ZYN_AGENT_WEB_ORIGIN=http://localhost:3000
# mock (fake VMs, works anywhere) or libvirt (real KVM VMs).
ZYN_VM_DRIVER=mock
# qcow2 or zfs.
ZYN_STORAGE_DRIVER=qcow2
# Where the agent keeps VM disks and its own state.
ZYN_DATA_DIR=./.data/agent
# Used by the ZFS storage driver only.
ZYN_ZFS_DATASET=tank/zynthera
# libvirt connection and network name.
ZYN_LIBVIRT_URI=qemu:///system
ZYN_LIBVIRT_NETWORK=zynthera
# CPU model shown to guests: host-model, or a named model for multi-host setups.
ZYN_VM_CPU_MODE=host-model
# Per-VM network cap in kilobytes per second (12500 = 100 Mbit/s).
ZYN_VM_BANDWIDTH_KBYTES=12500
# Port the file bridge listens on inside guests.
ZYN_FILE_BRIDGE_PORT=7070
# The desktop every mock VM shows (the dev-desktop container).
ZYN_MOCK_VNC_ADDR=127.0.0.1:5901
# Operations the mock driver should fail, for testing. Example: suspend,start
ZYN_MOCK_FAIL=
# Seconds between heartbeats.
ZYN_HEARTBEAT_SECONDS=10
# The agent enforces ZYN_MAX_UPLOAD_MB (set above for the API) while a file
# is being uploaded. On a real host, put the same value in agent.env.

# ---------------------------------------------------------------- Web
NEXT_PUBLIC_APP_NAME=Zynthera
# Where the web app forwards /api requests.
API_INTERNAL_URL=http://127.0.0.1:8080
